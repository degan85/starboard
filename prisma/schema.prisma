// starboard - Database Schema
// Prisma ORM for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Auth (NextAuth) ============

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ App Models ============

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Subscription
  plan          Plan      @default(FREE)
  
  // Lemon Squeezy
  lsCustomerId       String?   @unique
  lsSubscriptionId   String?   @unique
  lsVariantId        String?
  lsCurrentPeriodEnd DateTime?
  lsCancelledAt      DateTime?  // 취소 요청 날짜 (null이면 활성)
  
  // Legacy Stripe (can be removed later)
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?  @unique
  stripePriceId       String?
  stripeCurrentPeriodEnd DateTime?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  
  // Widget settings
  widgetTheme   WidgetTheme @default(LIGHT)
  widgetLayout  WidgetLayout @default(GRID)
  primaryColor  String @default("#6366f1")
  
  // Relations
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testimonials Testimonial[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  
  // Content
  name       String
  email      String?
  company    String?
  role       String?
  content    String   @db.Text
  rating     Int      @default(5)
  avatarUrl  String?
  
  // Status
  approved   Boolean  @default(false)
  featured   Boolean  @default(false)
  
  // Relations
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([projectId])
  @@index([approved])
}

// ============ Enums ============

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum WidgetTheme {
  LIGHT
  DARK
  AUTO
}

enum WidgetLayout {
  GRID
  CAROUSEL
  LIST
}
