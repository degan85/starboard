# =================================
# starboard Environment Variables
# =================================

# Database (Neon, Supabase, or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/starboard?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Lemon Squeezy (for payments)
LEMONSQUEEZY_API_KEY="your-api-key"
LEMONSQUEEZY_STORE_ID="your-store-id"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-secret"

# Lemon Squeezy Product Variant IDs
LEMONSQUEEZY_PRO_VARIANT_ID="123456"
LEMONSQUEEZY_BUSINESS_VARIANT_ID="123457"
